<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>local.antenna-observatory.web</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__HOME__/Library/Application Support/AntennaObservatory/app/server/observatory.py</string>
		<string>--port</string>
		<string>8787</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/antenna-observatory.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/antenna-observatory.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
